# Start with Android 14 for the first integration test.
REDROID_IMAGE=redroid/redroid:14.0.0-latest
REDROID_WIDTH=1920
REDROID_HEIGHT=1080
REDROID_DPI=240

# Replace with: openssl rand -hex 32. Never commit the generated value.
GATEWAY_TOKEN=replace-with-a-random-secret-of-at-least-32-characters

# Set this to the exact HTTPS origin hosting the browser UI.
# Leave empty only for local same-origin/proxy development.
ALLOWED_ORIGIN=

# Optional browser streaming sidecar. Current upstream Docker image is amd64-only.
WS_SCRCPY_IMAGE=bilbospocketses/ws-scrcpy-web:0.5.13

# Keep 0 normally. Temporarily set to 1 only for first-admin bootstrap on loopback,
# then enable ws-scrcpy-web login and set this back to 0.
WS_SCRCPY_ALLOW_REMOTE_ADMIN=0
