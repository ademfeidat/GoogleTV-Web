{
  "name": "googletv-web",
  "private": true,
  "version": "0.9.5",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/check-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "check": "node --check src/main.js && node --check src/redroid.js && node --check src/redroid-client.js && node --check server/gateway/src/server.js && node --check vite.config.js",
    "postinstall": "node scripts/copy-v86-assets.mjs",
    "test": "node --test",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "v86": "0.5.476"
  },
  "devDependencies": {
    "vite": "^6.4.1",
    "playwright": "1.56.1"
  }
}
